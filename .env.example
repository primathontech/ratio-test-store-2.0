# =============================================================================
# Ratio storefront — environment
# =============================================================================
# Merchant-specific config. Switching merchant = change the values here only
# (no code/UI edits). Keep this file out of version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Commerce platform & merchant identity
# -----------------------------------------------------------------------------
# Backend type: "custom" (GoKwik) or "shopify". Both server + public copies.
PLATFORM=custom
NEXT_PUBLIC_PLATFORM=custom

# Merchant / store identifiers — all point at the same GoKwik merchant.
MERCHANT_ID=196jdfqy1aot
NEXT_PUBLIC_MERCHANT_ID=196jdfqy1aot
NEXT_PUBLIC_STORE_ID=196jdfqy1aot

# Theme folder + internal merchant name (src/themes/<name>).
MERCHANT_NAME=ratio
NEXT_PUBLIC_MERCHANT_NAME=ratio
NEXT_PUBLIC_THEME_NAME=ratio

# -----------------------------------------------------------------------------
# Site / SEO
# -----------------------------------------------------------------------------
# Root URL (no trailing slash) — canonical URLs, OG tags, sitemap, structured data.
NEXT_PUBLIC_BASE_URL=https://ratioproduction.ratio.win
# Brand/store name — <title> tags, structured data, footer copyright.
NEXT_PUBLIC_SITE_NAME=Ratio

# -----------------------------------------------------------------------------
# Commerce data APIs (custom / GoKwik backend)
# -----------------------------------------------------------------------------
# Catalog (products/collections), cart, customer, orders, search endpoints.
NEXT_PUBLIC_CUSTOM_API_PRODUCT_URL=https://gkx.gokwik.co/ps
NEXT_PUBLIC_CUSTOM_API_CART_URL=https://gkx.gokwik.co/os
NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL=https://gkx.gokwik.co/os/api/v1
NEXT_PUBLIC_CUSTOMER_API_URL=https://gkx.gokwik.co/cs/v1
NEXT_PUBLIC_SEARCH_API_URL=https://api-gw.gokwik.io/search/api/v1

# -----------------------------------------------------------------------------
# Storefront config & navigation (admin-managed via @shopkit/*)
# -----------------------------------------------------------------------------
# Gateway base for admin config: nav menus (useNav) + SEO config.
NEXT_PUBLIC_STOREFRONT_API_URL=https://api-gw-v4.gokwik.io/pi/pc/api/v1
# Legacy nav-only fallback (kept for compatibility).
NEXT_PUBLIC_NAV_MENU_API_URL=https://api-gw-v4.gokwik.io/pi/pc/api/v1

# -----------------------------------------------------------------------------
# GoKwik checkout
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOKWIK_ENABLED=true
NEXT_PUBLIC_GOKWIK_ENVIRONMENT=production
NEXT_PUBLIC_GOKWIK_MID=196jdfqy1aot
NEXT_PUBLIC_GOKWIK_TYPE=merchantInfo
NEXT_PUBLIC_GOKWIK_SCRIPT_URL=https://pdp.gokwik.co
NEXT_PUBLIC_GOKWIK_DISCOUNT_API_URL=https://gkx.gokwik.co/pi/od/api/v1/os-discount/fetch

# -----------------------------------------------------------------------------
# KwikCart (GoKwik side cart)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKCART_DISABLE=false
NEXT_PUBLIC_KWIKCART_SCRIPT_URL=https://kwikcart.gokwik.co/kwikcart/side-cart-os.js
NEXT_PUBLIC_KWIKCART_CURRENCY=INR
NEXT_PUBLIC_KWIKCART_CURRENCY_FORMAT=en-IN

# -----------------------------------------------------------------------------
# Visual editor
# -----------------------------------------------------------------------------
# Enable editor-driven config changes at runtime.
NEXT_PUBLIC_ENABLE_EDITOR_CHANGES=false

# -----------------------------------------------------------------------------
# Voice AI (Ratio Voice AI assistant)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VOICE_STORE_NAME=ratio
NEXT_PUBLIC_VOICE_STORE_SPECIALTY=haircare
# OpenAI key powering the voice assistant (SECRET).
OPENAI_API_KEY=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

# -----------------------------------------------------------------------------
# Ratio Forms
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RATIO_FORMS_SDK_URL=https://ratio.apps.primathontech.co.in/forms/sdk/196jdfqy1aot.js

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------
# Signing secret for verifying inbound webhooks (SECRET).
WEBHOOK_SECRET=whsec_LKhNJjCzZrE54JRdGfD_rMe8381nqF8cKAhZvg3TwB0
