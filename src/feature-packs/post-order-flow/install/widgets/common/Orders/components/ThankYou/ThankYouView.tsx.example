"use client";

import { useCheckoutToken } from "@/integrations/kwikpass-custom";
import Link from "next/link";
import React, { useEffect, useState } from "react";
import { ThankYouHeader } from "./Header";
import { AddressSection } from "./AddressSection";
import { RightSection } from "./RightSection";
import { PriceDisplay } from "./PriceDisplay";
import { OrderSummaryAccordion } from "./OrderSummaryAccordion";
import { ThankYouFooter } from "./ThankYouFooter";
import { OrderApiResponse } from "./types";
import { formatDateSafe } from "../../utils";
import { getOrderDetails } from "../../api";

export const ThankYouView: React.FC = () => {
  const gkToken = useCheckoutToken();
  const [orderData, setOrderData] = useState<OrderApiResponse | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;

    const fetchOrder = async () => {
      const searchParams = new URLSearchParams(window.location.search);
      const orderId = searchParams.get("orderId");
      const requestId = searchParams.get("requestId");
      const customerId = searchParams.get("customerId");

      if (!orderId) {
        if (!cancelled) {
          setError("Order ID not found in URL");
          setLoading(false);
        }
        return;
      }

      // If we have an orderId but no token yet, wait for auth to hydrate.
      if (!gkToken) {
        return;
      }

      try {
        const result = await getOrderDetails({
          orderId,
          requestId: requestId || undefined,
          customerId: customerId || undefined,
          gkAccessToken: gkToken,
        });

        if (cancelled) {
          return;
        }

        if (result?.order) {
          setOrderData(result);
        } else {
          setError("Failed to load order details");
        }
      } catch (e) {
        console.error("Failed to fetch order:", e);
        if (!cancelled) {
          setError("Failed to load order details");
        }
      } finally {
        if (!cancelled) {
          setLoading(false);
        }
      }
    };

    fetchOrder();

    return () => {
      cancelled = true;
    };
  }, [gkToken]);

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-white">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-4 border-black border-t-transparent mx-auto mb-4" />
          <p className="text-gray-600">Loading your order details...</p>
        </div>
      </div>
    );
  }

  if (error || !orderData?.order) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-white">
        <div className="text-center max-w-md mx-auto px-4">
          <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg
              className="w-8 h-8 text-red-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                strokeWidth={2}
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <h1 className="text-2xl font-bold text-gray-900 mb-2">
            Unable to Load Order
          </h1>
          <p className="text-gray-600 mb-4">{error || "Order not found"}</p>
          <Link
            href="/"
            className="px-6 py-3 bg-black text-white rounded-md hover:bg-gray-800 transition-colors"
          >
            Return to Home
          </Link>
        </div>
      </div>
    );
  }

  return (
    <div className="storefront-thank-you">
      <style>{`@media (max-width: 1025px) { body:has(.storefront-thank-you) { padding-bottom: 0 !important; } }`}</style>
      <div className="bg-[#f5f5f5]">
        <OrderSummaryAccordion order={orderData.order} className="md:hidden" />

        {/* Order Header */}
        <div className="md:mb-6 py-[21px] md:py-[28px] px-[21px] md:px-[38px] max-w-[1200px] mx-auto flex flex-col gap-y-[26px] md:flex-row justify-between">
          <div>
            <h2 className="text-[21px] text-black font-semibold">
              Order {orderData.order.name}
            </h2>
            <p className="text-[14px] text-[#666]">
              Confirmed{" "}
              {formatDateSafe(orderData.order.created_at, {
                month: "short",
                day: "numeric",
              })}
            </p>
          </div>

          <Link
            href="/"
            className="bg-white p-[14px] border rounded-[8px] border-[#d6d6d6] text-[#005bd1] text-[14px] font-semibold text-center"
          >
            Go Back to Homepage
          </Link>
        </div>

        <PriceDisplay
          amount={orderData.order.total_price}
          currency="INR"
          className="md:hidden mx-[21px]"
        />

        {/* Main Layout Grid */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 pt-[21px] pb-[38px] px-[21px] md:px-[38px] max-w-[1200px] mx-auto">
          {/* Left Column */}
          <div className="lg:col-span-7">
            <ThankYouHeader order={orderData.order} />
            <AddressSection order={orderData.order} />
          </div>

          {/* Right Column */}
          <div className="lg:col-span-5 flex flex-col gap-[21px]">
            <PriceDisplay
              amount={orderData.order.total_price}
              currency="INR"
              className="hidden md:block"
            />
            <RightSection order={orderData.order} className="hidden md:block" />
          </div>
        </div>

        {/* Footer */}
        <div className="md:px-[38px] max-w-[1200px] mx-auto">
          <ThankYouFooter />
        </div>
      </div>
    </div>
  );
};
