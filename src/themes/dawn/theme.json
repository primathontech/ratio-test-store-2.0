      "prepaid-text": "#D6A243",
      "lighter-gray": "#ebebebcc",
      "gray-light": "#EBEBEB",
      "bg-gray": "#F4F6F8",
      "lightest-gray": "#727272",
      "error": "#e53e3e",
      "success": "#38a169",
