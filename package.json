{
  "name": "momsco",
  "version": "0.1.33",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4344",
    "build": "next build",
    "build:skip-lint": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "prepare": "husky",
    "predev": "bun run generate",
    "prebuild": "bun run generate",
    "generate": "bun run generate:widgets && bun run generate:templates && bun run generate:i18n",
    "generate:widgets": "shopkit generate:widgets",
    "generate:templates": "shopkit generate:templates",
    "generate:i18n": "shopkit generate:i18n",
    "watch:widgets": "shopkit watch:widgets",
    "watch:locales": "shopkit watch:locales",
    "dev:watch": "bun run generate && (bun run watch:widgets & bun run watch:locales & next dev -p 4344)",
    "migrate:theme": "shopkit-editor-bridge-migrate",
    "cli": "shopkit",
    "create:widget": "shopkit g widget",
    "g": "shopkit g",
    "g:theme": "shopkit g theme",
    "g:widget": "shopkit g widget",
    "g:template": "shopkit g template",
    "validate:widget": "shopkit validate:widget",
    "validate:template": "shopkit validate:template",
    "validate:route": "shopkit validate:route",
    "validate:assets": "shopkit validate:assets",
    "perf:validate": "shopkit validate:widget && shopkit validate:template && shopkit validate:route",
    "perf:validate:staged": "shopkit validate:widget --staged-only && shopkit validate:template --staged-only && shopkit validate:route --staged-only",
    "perf:score": "shopkit perf:score --staged-only",
    "perf:score:all": "shopkit perf:score",
    "perf:check": "bun run perf:validate && bun run lint && bun run perf:score",
    "perf:rules": "shopkit perf:rules",
    "perf:assets": "shopkit validate:assets",
    "perf:critical": "shopkit perf:critical",
    "perf:audit": "shopkit perf:audit"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/themes": "^3.2.1",
    "@shopify/hydrogen-react": "^2025.5.0",
    "@shopify/storefront-api-client": "^1.0.8",
    "@shopkit/events": "^0.12.0",
    "@shopkit/app-shell": "^2.0.0",
    "@shopkit/apps-platform": "^0.1.1",
    "@shopkit/apps-platform-react": "^0.1.0",
    "@shopkit/asset-cache": "^1.0.1",
    "@shopkit/builder": "^0.1.5",
    "@shopkit/cart": "^0.1.4",
    "@shopkit/navigation": "^1.5.1",
    "@shopkit/cli": "^0.4.0",
    "@shopkit/core": "^0.1.7",
    "@shopkit/data-layer": "^1.4.2",
    "@shopkit/discounts": "^0.1.3",
    "@shopkit/editor-bridge": "^0.8.0",
    "@shopkit/i18n": "^0.1.4",
    "@shopkit/seo": "^1.2.1",
    "@shopkit/webhooks": "^0.2.2",
    "jose": "^6.0.11",
    "next": "14.2.35",
    "next-intl": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.0.1",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.33",
    "@types/react-dom": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "postcss": "^8.4.31",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
