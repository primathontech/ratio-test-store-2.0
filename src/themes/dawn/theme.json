  "supportedLanguages": ["en"],
  "defaultLanguage": "en",
  "config": {
    "colors": {
      "primary": "#1D1D1D",
      "secondary": "#ffffff",
      "black": "#000000",
      "surface": "#727272",
      "surface-3": "#e2e8f0",
