# =============================================================================
# Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Commerce Platform Configuration
# -----------------------------------------------------------------------------
# Choose your commerce platform: "shopify" or "custom"
NEXT_PUBLIC_COMMERCE_PLATFORM=custom

# -----------------------------------------------------------------------------
# Shopify Configuration (if using Shopify)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# -----------------------------------------------------------------------------
# Custom Backend Configuration (if using custom)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CUSTOM_API_URL=https://your-api.com
NEXT_PUBLIC_MERCHANT_ID=your-merchant-id

# -----------------------------------------------------------------------------
# GoKwik Checkout Integration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOKWIK_MID=your-gokwik-merchant-id
NEXT_PUBLIC_GOKWIK_ENVIRONMENT=sandbox
NEXT_PUBLIC_GOKWIK_TYPE=your-gokwik-type
NEXT_PUBLIC_GOKWIK_SCRIPT_URL=https://cdn.gokwik.co

# Optional: Banner messages shown in checkout
NEXT_PUBLIC_GOKWIK_BANNER_MESSAGE_1=Free shipping on orders above ₹499
NEXT_PUBLIC_GOKWIK_BANNER_MESSAGE_2=Easy returns within 7 days

# -----------------------------------------------------------------------------
# GoKwik KwikPass (Authentication)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKPASS_MID=your-kwikpass-merchant-id
NEXT_PUBLIC_KWIKPASS_ENVIRONMENT=sandbox
NEXT_PUBLIC_KWIKPASS_SCRIPT_URL=https://cdn.gokwik.co

# -----------------------------------------------------------------------------
# GoKwik KwikCart (Side Cart)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKCART_DISABLE=false
NEXT_PUBLIC_KWIKCART_SCRIPT_URL=https://qa.kwikcart.gokwik.co/kwikcart/side-cart.js
NEXT_PUBLIC_KWIKCART_CURRENCY=INR
NEXT_PUBLIC_KWIKCART_CURRENCY_FORMAT=en-IN

# -----------------------------------------------------------------------------
# Order History API (for /orders page)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL=https://your-api.com

# -----------------------------------------------------------------------------
# Analytics & Tracking (Optional)
# -----------------------------------------------------------------------------
# Comma-separated Facebook Pixel IDs (supports multiple pixels)
NEXT_PUBLIC_MULTI_PIXEL_IDS=your-pixel-id-1,your-pixel-id-2
NEXT_PUBLIC_GOOGLE_ADS_ID=your-google-ads-id
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL=your-conversion-label

# Google Tag Manager — merchant-controlled container.
# When set, gtm-pixel-sdk.js loads the container, applies Consent Mode v2
# defaults, and mirrors PixelRuntime events into window.dataLayer using GA4
# Enhanced Ecommerce schema. Leave blank to disable.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Optional — only needed for GTM Server-Side environments (preview/staging)
# NEXT_PUBLIC_GTM_AUTH=your-gtm-server-side-auth-token
# NEXT_PUBLIC_GTM_PREVIEW=env-X
# Optional — ISO 4217 currency for ecommerce events (default "INR")
# NEXT_PUBLIC_CURRENCY=USD
# Optional — force verbose GTM SDK console logs in production
# NEXT_PUBLIC_GTM_DEBUG=true

# -----------------------------------------------------------------------------
# Facebook Conversions API (Server-side)
# -----------------------------------------------------------------------------
# Format: pixelId1:accessToken1,pixelId2:accessToken2
FACEBOOK_MULTI_CAPI_ACCESS_TOKENS=your-pixel-id:your-capi-access-token
# Optional: override Graph API URL
# FACEBOOK_CAPI_BASE_URL=https://graph.facebook.com/v21.0
# HMAC secret for CAPI endpoint security (generate with: openssl rand -hex 32)
NEXT_PUBLIC_CAPI_HMAC_SECRET=your-capi-hmac-secret

# -----------------------------------------------------------------------------
# Theme Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_THEME_NAME=dawn

# -----------------------------------------------------------------------------
# Visual Editor (editor-bridge)
# -----------------------------------------------------------------------------
# Origin(s) the editor bridge trusts — drives both the CSP frame-ancestors
# allowlist and the runtime postMessage/origin gate. Single origin, or several
# comma-separated. No trailing slash. Unset → bridge fails closed (no embedding).
NEXT_PUBLIC_EDITOR_ORIGIN=https://storefront-editor-2.vercel.app
# Build-time switch: "true" picks the editor section wrapper + template loader.
NEXT_PUBLIC_ENABLE_EDITOR_CHANGES=false

# -----------------------------------------------------------------------------
# Redis (Optional - for caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:4344
NODE_ENV=development
