/**
 * API functions for Orders widget.
 *
 * Calls the GoKwik order-history backend directly from the browser.
 * `gk-access-token` is passed as a header (never as a query-string param)
 * to keep it out of URL logs, Referer headers, and Sentry breadcrumbs.
 */

import { OrderApiResponse } from "../types";

export interface OrdersListParams {
  page?: number;
  limit?: number;
  requestId?: string;
  customerId?: string;
  phone: string;
  gkAccessToken?: string;
}

export interface OrderDetailsParams {
  orderId: string;
  requestId?: string;
  customerId?: string;
  phone?: string;
  gkAccessToken?: string;
}

export interface OrderListPagination {
  total: number;
  page: number;
  limit: number;
  totalPages: number;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
}

export interface OrderListResponse {
  orders: OrderApiResponse[];
  pagination?: OrderListPagination;
}

function buildOrderHeaders(params: {
  requestId?: string;
  customerId?: string;
  phone?: string;
  gkAccessToken?: string;
}): Record<string, string> {
  const merchantId = process.env.NEXT_PUBLIC_MERCHANT_ID || "";
  return {
    accept: "application/json",
    "gk-merchant-id": merchantId,
    "Gk-Merchant-Id": merchantId,
    "merchant-mid": merchantId,
    "Gk-Request-Id": params.requestId || "",
    "Gk-Customer-Id": params.customerId || "",
    "Gk-Phone": params.phone || "",
    "gk-access-token": params.gkAccessToken || "",
  };
}

/**
 * Fetches orders list with pagination.
 */
export const getOrdersList = async (
  params: OrdersListParams
): Promise<OrderListResponse | null> => {
  try {
    const baseURL = process.env.NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL;
    if (!baseURL) {
      console.error("NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL not configured");
      return null;
    }

    const searchParams = new URLSearchParams({
      page: (params.page || 1).toString(),
      limit: (params.limit || 10).toString(),
      tracking: "true",
    });

    // eslint-disable-next-line no-restricted-syntax
    const response = await fetch(
      `${baseURL}/api/v1/auth/customers/orders?${searchParams.toString()}`,
      {
        method: "GET",
        headers: buildOrderHeaders({
          requestId: params.requestId,
          customerId: params.customerId,
          phone: params.phone,
          gkAccessToken: params.gkAccessToken,
        }),
      }
    );

    if (!response.ok) {
      console.error(`API Error: ${response.status} ${response.statusText}`);
      return null;
    }

    const result = await response.json();
    return result;
  } catch (error) {
    console.error("Error fetching orders list:", error);
    return null;
  }
};

/**
 * Fetches single order details.
 */
export const getOrderDetails = async (
  params: OrderDetailsParams
): Promise<OrderApiResponse | null> => {
  try {
    const baseURL = process.env.NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL;
    if (!baseURL) {
      console.error("NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL not configured");
      return null;
    }

    // eslint-disable-next-line no-restricted-syntax
    const response = await fetch(
      `${baseURL}/api/v1/auth/customers/orders/${params.orderId}`,
      {
        method: "GET",
        headers: buildOrderHeaders({
          requestId: params.requestId,
          customerId: params.customerId,
          phone: params.phone,
          gkAccessToken: params.gkAccessToken,
        }),
      }
    );

    if (!response.ok) {
      console.error(`API Error: ${response.status} ${response.statusText}`);
      return null;
    }

    const result = await response.json();
    return result;
  } catch (error) {
    console.error("Error fetching order details:", error);
    return null;
  }
};
