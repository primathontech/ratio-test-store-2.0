"use client";

import { useAuth } from "@shopkit/core/context";
import Link from "next/link";
import React, { useEffect, useState } from "react";
import { Pagination } from "../../Addresses/components/Pagination";
import { OrderApiResponse } from "../types";
import { getPaymentUIStatus, formatPaiseToINR, TrackingStatus } from "../utils";
import { CancelOrderModal } from "./CancelOrderModal";
import { OrderStatusCell } from "./OrderStatusCell";

interface OrderHistoryProps {
  orders?: OrderApiResponse[];
  totalPages: number;
  currentPage: number;
  onPageChange: (page: number) => void;
  onOrderUpdate?: () => void;
}

interface CancellationEligibility {
  [orderId: string]: {
    eligible: boolean;
    loading: boolean;
    error: string | null;
    reasons?: string[];
  };
}

// Checkmark icon for empty state
const CheckmarkIcon = () => (
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    className="p-2"
  >
    <path
      d="M20 6L9 17L4 12"
      stroke="white"
      strokeWidth="4"
      strokeLinecap="round"
      strokeLinejoin="round"
    />
  </svg>
);

export const OrderHistory: React.FC<OrderHistoryProps> = ({
  orders = [],
  totalPages = 1,
  currentPage,
  onPageChange,
  onOrderUpdate,
}) => {
  const { accessToken } = useAuth();
  const [cancellationEligibility, setCancellationEligibility] =
    useState<CancellationEligibility>({});

  const [modalState, setModalState] = useState<{
    isOpen: boolean;
    orderId: string | null;
    orderNumber: string | null;
  }>({
    isOpen: false,
    orderId: null,
    orderNumber: null,
  });

  const [cancellingOrders, setCancellingOrders] = useState<Set<string>>(
    new Set()
  );

  const checkCancellationEligibility = async (orderId: string) => {
    const gkMerchantId = process.env.NEXT_PUBLIC_MERCHANT_ID || "";
    const baseURL = process.env.NEXT_PUBLIC_CUSTOM_API_CART_URL;

    setCancellationEligibility((prev) => ({
      ...prev,
      [orderId]: { eligible: false, loading: true, error: null },
    }));

    try {
      if (!baseURL) {
        throw new Error("NEXT_PUBLIC_CUSTOM_API_CART_URL not configured");
      }

      // eslint-disable-next-line no-restricted-syntax
      const response = await fetch(
        `${baseURL}/auth/customers/orders/${orderId}/cancellable`,
        {
          method: "GET",
          headers: {
            "gk-access-token": (accessToken as string) || "",
            "gk-merchant-id": gkMerchantId,
            accept: "*/*",
          },
        }
      );

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const data = await response.json();

      // Extract reasons from the eligibility response. Field name may vary
      // across backend revisions — accept common shapes defensively.
      const reasons: string[] | undefined = Array.isArray(data?.reasons)
        ? data.reasons
        : Array.isArray(data?.cancellationReasons)
          ? data.cancellationReasons
          : Array.isArray(data?.data?.reasons)
            ? data.data.reasons
            : undefined;

      setCancellationEligibility((prev) => ({
        ...prev,
        [orderId]: {
          eligible: data.eligible || false,
          loading: false,
          error: null,
          reasons,
        },
      }));
    } catch (error) {
      console.error(
        `Error checking cancellation eligibility for order ${orderId}:`,
        error
      );
      setCancellationEligibility((prev) => ({
        ...prev,
        [orderId]: {
          eligible: false,
          loading: false,
          error: "Failed to check eligibility",
        },
      }));
    }
  };

  useEffect(() => {
    if (!accessToken || !orders || orders.length === 0) {
      return;
    }

    orders.forEach(({ order }) => {
      if (order?.tracking?.status === TrackingStatus.CANCELLED) {
        return;
      }

      if (!cancellationEligibility[order.id]) {
        checkCancellationEligibility(order.id);
      }
    });
  }, [orders, accessToken]);

  const handleCancelOrder = (orderId: string) => {
    const order = orders.find(({ order }) => order.id === orderId)?.order;
    setModalState({
      isOpen: true,
      orderId,
      orderNumber: order?.name || null,
    });
  };

  const handleModalClose = () => {
    setModalState({
      isOpen: false,
      orderId: null,
      orderNumber: null,
    });
  };

  const handleConfirmCancellation = async (
    reason?: string,
    customText?: string
  ) => {
    if (!modalState.orderId || !reason) {
      return;
    }

    const orderId = modalState.orderId;

    setCancellingOrders((prev) => new Set([...Array.from(prev), orderId]));

    try {
      const merchantId = process.env.NEXT_PUBLIC_MERCHANT_ID;
      const baseURL = process.env.NEXT_PUBLIC_CUSTOM_API_CART_URL;

      if (!accessToken) {
        throw new Error("Access token not found");
      }

      if (!merchantId) {
        throw new Error("Merchant ID not configured");
      }

      if (!baseURL) {
        throw new Error("NEXT_PUBLIC_CUSTOM_API_CART_URL not configured");
      }

      let requestBody: any;

      if (reason === "Others" && customText) {
        requestBody = {
          status: "cancelled",
          reason: "Other",
          cancelReasonText: customText,
        };
      } else {
        requestBody = {
          status: "cancelled",
          reason: reason,
        };
      }

      // eslint-disable-next-line no-restricted-syntax
      const response = await fetch(
        `${baseURL}/auth/customers/orders/${orderId}/cancel`,
        {
          method: "POST",
          headers: {
            accept: "*/*",
            "Content-Type": "application/json",
            "gk-access-token": accessToken as string,
            "gk-merchant-id": merchantId,
          },
          body: JSON.stringify(requestBody),
        }
      );

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.error || "Failed to cancel order");
      }

      handleModalClose();
      setCancellingOrders((prev) => {
        const newSet = new Set(prev);
        newSet.delete(orderId);
        return newSet;
      });

      if (onOrderUpdate) {
        onOrderUpdate();
      }
    } catch (error) {
      console.error(`Error cancelling order ${orderId}:`, error);

      setCancellingOrders((prev) => {
        const newSet = new Set(prev);
        newSet.delete(orderId);
        return newSet;
      });

      alert(
        `Failed to cancel order: ${error instanceof Error ? error.message : "Unknown error"}`
      );
    }
  };

  return (
    <div data-testid="storefront-order-history-container" className="flex-1">
      <div data-testid="storefront-order-history-content">
        <h2
          data-testid="storefront-order-history-title"
          className="text-[16px] font-bold text-black my-[18px]"
        >
          Order history
        </h2>

        {!orders || orders.length === 0 ? (
          <div
            data-testid="storefront-order-history-empty-state"
            className="border-[2px] border-green-700 rounded-[2.5px] py-[14px] px-[25px] mt-8 flex items-center gap-4"
          >
            <div
              data-testid="storefront-order-history-empty-state-icon"
              className="flex-shrink-0 w-9 h-9 bg-green-700 rounded-full flex items-center justify-center"
            >
              <CheckmarkIcon />
            </div>
            <div
              data-testid="storefront-order-history-empty-state-content"
              className="flex items-center flex-wrap md:flex-nowrap gap-2"
            >
              <Link
                href="/"
                data-testid="storefront-order-history-empty-state-link"
                className="text-green-700 underline text-[14px] font-semibold whitespace-nowrap"
              >
                MAKE YOUR FIRST ORDER
              </Link>
              <p
                data-testid="storefront-order-history-empty-state-text"
                className="text-green-700 text-[14px] whitespace-nowrap"
              >
                You haven&apos;t placed any orders yet.
              </p>
            </div>
          </div>
        ) : (
          <>
            {/* Desktop Table View */}
            <div
              data-testid="storefront-order-history-desktop-table"
              className="hidden md:block border border-gray-200 rounded-lg overflow-hidden"
            >
              <table className="w-full">
                <thead>
                  <tr className="border-b border-gray-200">
                    <th className="text-center font-bold text-black text-[14px] py-[18px] px-[10px]">
                      ORDER
                    </th>
                    <th className="text-center font-bold text-black text-[14px] py-[18px] px-[10px]">
                      PLACED ON
                    </th>
                    <th className="text-center font-bold text-black text-[14px] py-[18px] px-[10px]">
                      PAYMENT STATUS
                    </th>
                    <th className="text-center font-bold text-black text-[14px] py-[18px] px-[10px]">
                      DELIVERY BY
                    </th>
                    <th className="text-center font-bold text-black text-[14px] py-[18px] px-[10px]">
                      TOTAL
                    </th>
                    <th className="text-center font-bold text-black text-[14px] py-[18px] px-[10px]">
                      ORDER STATUS
                    </th>
                    <th className="text-center font-bold text-black text-[14px] py-[18px] px-[10px]">
                      DETAILS
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {orders.map((item, index) => {
                    const { order } = item;

                    return (
                      <tr
                        key={order.id}
                        className={`border-b border-gray-200 h-[57px]${
                          index === orders.length - 1 ? "last:border-b-0" : ""
                        }`}
                      >
                        <td className="text-center text-black text-[14px] p-[10px]">
                          {order.name}
                        </td>
                        <td
                          className="text-center text-black text-[14px] p-[10px]"
                          suppressHydrationWarning
                        >
                          {new Date(order.created_at).toLocaleDateString(
                            "en-US",
                            {
                              day: "2-digit",
                              month: "long",
                              year: "numeric",
                            }
                          )}
                        </td>
                        <td className="text-center text-black text-[14px] p-[10px]">
                          {order.payment_status ? (
                            <span
                              className={`inline-block rounded-full text-[12px] font-medium ${
                                getPaymentUIStatus(order.payment_status) ===
                                "Prepaid"
                                  ? "bg-green-100 text-green-800 px-[11px] py-[4px]"
                                  : "bg-yellow-100 text-yellow-800 px-2 py-1"
                              }`}
                            >
                              {getPaymentUIStatus(order.payment_status)}
                            </span>
                          ) : (
                            "-"
                          )}
                        </td>
                        <td className="text-center text-black text-[14px] p-[10px]">
                          {order?.tracking && order?.tracking.edd
                            ? new Date(order.tracking.edd).toLocaleDateString(
                                "en-US",
                                {
                                  day: "2-digit",
                                  month: "short",
                                  year: "numeric",
                                }
                              )
                            : ""}
                        </td>
                        <td className="text-center text-black text-[14px] p-[10px]">
                          {formatPaiseToINR(Number(order?.total_price))}
                        </td>
                        <td className="text-center text-black text-[14px] p-[10px]">
                          <OrderStatusCell
                            order={order}
                            eligibility={cancellationEligibility[order.id]}
                            onCancelOrder={handleCancelOrder}
                            isCancelling={cancellingOrders.has(order.id)}
                            isModalOpen={
                              modalState.isOpen &&
                              modalState.orderId === order.id
                            }
                          />
                        </td>
                        <td className="text-center text-black text-[14px] p-[10px]">
                          <Link
                            href={`/pages/orders/${order.id}`}
                            data-testid={`storefront-order-history-view-link-${order.id}`}
                            className="text-blue-600 hover:text-blue-800 underline underline-offset-4"
                          >
                            View
                          </Link>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {/* Mobile Card View */}
            <div
              data-testid="storefront-order-history-mobile-cards"
              className="md:hidden space-y-4"
            >
              {orders.map((item) => {
                const { order } = item;
                const orderedDate = new Date(
                  order.created_at
                ).toLocaleDateString("en-US", {
                  day: "2-digit",
                  month: "long",
                  year: "numeric",
                });

                return (
                  <div
                    key={order.id}
                    data-testid={`storefront-order-history-mobile-card-${order.id}`}
                    className="border border-gray-200 rounded-[16px] mb-[20px] bg-white max-h-[230.8px]"
                  >
                    <div className="px-[16px] pt-[16px]">
                      <div className="space-y-2">
                        <div className="flex justify-between !mt-0 pb-[10px]">
                          <span className="text-black text-sm font-bold uppercase">
                            Order
                          </span>
                          <span className="text-sm">{order.name}</span>
                        </div>
                        <div className="flex justify-between !mt-0 pb-[10px]">
                          <span className="text-black text-sm font-bold uppercase">
                            Ordered Date
                          </span>
                          <span className="text-sm" suppressHydrationWarning>
                            {orderedDate}
                          </span>
                        </div>
                        <div className="flex justify-between !mt-0 pb-[10px]">
                          <span className="text-black text-sm font-bold uppercase">
                            Payment Status
                          </span>
                          {order.payment_status ? (
                            <span
                              className={`inline-block px-2 py-1 rounded-full text-sm font-medium ${
                                getPaymentUIStatus(order.payment_status) ===
                                "Prepaid"
                                  ? "bg-green-100 text-green-800"
                                  : "bg-yellow-100 text-yellow-800"
                              }`}
                            >
                              {getPaymentUIStatus(order.payment_status)}
                            </span>
                          ) : (
                            <span className="text-sm">-</span>
                          )}
                        </div>
                        <div className="flex justify-between !mt-0 pb-[10px]">
                          <span className="text-black text-sm font-bold uppercase">
                            Delivery-By
                          </span>
                          <span className="text-sm">
                            {order?.tracking && order?.tracking.edd
                              ? new Date(order.tracking.edd).toLocaleDateString(
                                  "en-US",
                                  {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric",
                                  }
                                )
                              : ""}
                          </span>
                        </div>
                        <div className="flex justify-between !mt-0 pb-[10px]">
                          <span className="text-black text-sm font-bold uppercase">
                            Total
                          </span>
                          <span className="text-sm font-bold">
                            {formatPaiseToINR(Number(order?.total_price))}
                          </span>
                        </div>
                        <div className="flex justify-between !mt-0 pb-[10px]">
                          <span className="text-black text-sm font-bold uppercase">
                            Confirmation Status
                          </span>
                          <OrderStatusCell
                            order={order}
                            eligibility={cancellationEligibility[order.id]}
                            onCancelOrder={handleCancelOrder}
                            isCancelling={cancellingOrders.has(order.id)}
                            isModalOpen={
                              modalState.isOpen &&
                              modalState.orderId === order.id
                            }
                          />
                        </div>
                      </div>
                    </div>

                    <div className="border-t border-gray-100">
                      <Link
                        href={`/pages/orders/${order.id}`}
                        data-testid={`storefront-order-history-view-link-${order.id}`}
                        className="inline-flex items-center justify-center w-full px-4 py-[11px] text-blue-600 rounded-md text-[14px] font-medium transition-colors bg-gray-50"
                      >
                        View
                      </Link>
                    </div>
                  </div>
                );
              })}
            </div>

            <Pagination
              currentPage={currentPage}
              totalPages={Math.max(1, totalPages)}
              onPageChange={onPageChange}
              position="left"
            />
          </>
        )}
      </div>

      <CancelOrderModal
        isOpen={modalState.isOpen}
        onClose={handleModalClose}
        onConfirm={handleConfirmCancellation}
        orderNumber={modalState.orderNumber || ""}
        reasons={
          modalState.orderId
            ? cancellationEligibility[modalState.orderId]?.reasons
            : undefined
        }
        isLoading={
          modalState.orderId ? cancellingOrders.has(modalState.orderId) : false
        }
      />
    </div>
  );
};
