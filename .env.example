# =============================================================================
# Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Commerce Platform Configuration
# -----------------------------------------------------------------------------
# Choose your commerce platform: "shopify" or "custom"
NEXT_PUBLIC_COMMERCE_PLATFORM=custom

# -----------------------------------------------------------------------------
# Shopify Configuration (if using Shopify)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# -----------------------------------------------------------------------------
# Custom Backend Configuration (if using custom)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CUSTOM_API_URL=https://your-api.com
NEXT_PUBLIC_MERCHANT_ID=your-merchant-id

# -----------------------------------------------------------------------------
# Navigation / Mega Menu (@shopkit/navigation)
# -----------------------------------------------------------------------------
# Generic storefront-config gateway base — ONE URL for ALL admin config reads:
# navigation (@shopkit/navigation → /storefront/nav-menus/{handle}), SEO
# (@shopkit/seo → /storefront/configs/seo/default), and future config domains.
# Full gateway base INCLUDING the /api/v1 prefix; each package appends its own tail.
# If unset, both degrade gracefully (fallback nav / env-default SEO — no crash).
# CONTENT (menus, SEO title/description) is managed by the merchant in admin.
#   QA:   https://api-gw-v4.dev.gokwik.io/qa/pi/pc/api/v1
#   Prod: https://api-gateway.gokwik.io/api/v1
NEXT_PUBLIC_STOREFRONT_API_URL=

# DEPRECATED — legacy nav-only var. @shopkit/navigation still reads it as a fallback
# when NEXT_PUBLIC_STOREFRONT_API_URL is unset. Prefer the generic var above; this
# will be removed. Leave blank unless supporting an older deploy.
# NEXT_PUBLIC_NAV_MENU_API_URL=

# -----------------------------------------------------------------------------
# Visual Editor Integration
# -----------------------------------------------------------------------------
# THE switch for editor-saved templates. This is the only thing that decides
# whether templates come from the editor backend or from src/themes/ on disk —
# it selects the template loader once, in src/bootstrap/builder.ts. Compared
# strictly against the string "true"; anything else (including unset) means
# filesystem-only. Do NOT try to control this per-page: `fetchAPITemplate` in a
# page's routeContext is not read on the render path.
#   false / unset → templates load from src/themes/{theme}/templates/
#   true          → templates load from NEXT_PUBLIC_EDITOR_API_URL, falling back
#                   to the filesystem if the backend call fails
NEXT_PUBLIC_ENABLE_EDITOR_CHANGES=false

# Editor backend base URL. Only used when the flag above is "true".
# Defaults to https://visual-editor-be.primathontech.co.in when unset.
NEXT_PUBLIC_EDITOR_API_URL=

# -----------------------------------------------------------------------------
# GoKwik Checkout Integration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOKWIK_MID=your-gokwik-merchant-id
NEXT_PUBLIC_GOKWIK_ENVIRONMENT=sandbox
NEXT_PUBLIC_GOKWIK_TYPE=your-gokwik-type
NEXT_PUBLIC_GOKWIK_SCRIPT_URL=https://cdn.gokwik.co

# Optional: Banner messages shown in checkout
NEXT_PUBLIC_GOKWIK_BANNER_MESSAGE_1=Free shipping on orders above ₹499
NEXT_PUBLIC_GOKWIK_BANNER_MESSAGE_2=Easy returns within 7 days

# -----------------------------------------------------------------------------
# GoKwik KwikPass (Authentication)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKPASS_MID=your-kwikpass-merchant-id
NEXT_PUBLIC_KWIKPASS_ENVIRONMENT=sandbox
NEXT_PUBLIC_KWIKPASS_SCRIPT_URL=https://cdn.gokwik.co

# -----------------------------------------------------------------------------
# GoKwik KwikCart (Side Cart)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKCART_DISABLE=false
NEXT_PUBLIC_KWIKCART_SCRIPT_URL=https://qa.kwikcart.gokwik.co/kwikcart/side-cart.js
NEXT_PUBLIC_KWIKCART_CURRENCY=INR
NEXT_PUBLIC_KWIKCART_CURRENCY_FORMAT=en-IN

# -----------------------------------------------------------------------------
# Order History API (for /orders page)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL=https://your-api.com

# -----------------------------------------------------------------------------
# Analytics & Tracking (Optional)
# -----------------------------------------------------------------------------
# Comma-separated Facebook Pixel IDs (supports multiple pixels)
NEXT_PUBLIC_MULTI_PIXEL_IDS=your-pixel-id-1,your-pixel-id-2
NEXT_PUBLIC_GOOGLE_ADS_ID=your-google-ads-id
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL=your-conversion-label

# GoKwik checkout event ownership. When GoKwik's hosted checkout reports the
# checkout funnel itself (InitiateCheckout / AddShippingInfo / AddPaymentInfo /
# Purchase), set these to "true" so our pixels stop double-counting them. The
# client SDKs skip the events and /api/events/capi drops them server-side as a
# backstop for stale cached SDKs.
# NEXT_PUBLIC_GOKWIK_ENABLED=true          # Meta pixel + CAPI
# NEXT_PUBLIC_GA_ID_GOKWIK_ENABLED=true    # GA4
# NEXT_PUBLIC_GA_ADS_GOKWIK_ENABLED=true   # Google Ads

# Google Tag Manager — merchant-controlled container.
# When set, gtm-pixel-sdk.js loads the container, applies Consent Mode v2
# defaults, and mirrors PixelRuntime events into window.dataLayer using GA4
# Enhanced Ecommerce schema. Leave blank to disable.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Optional — only needed for GTM Server-Side environments (preview/staging)
# NEXT_PUBLIC_GTM_AUTH=your-gtm-server-side-auth-token
# NEXT_PUBLIC_GTM_PREVIEW=env-X
# Optional — ISO 4217 currency for ecommerce events (default "INR")
# NEXT_PUBLIC_CURRENCY=USD
# Optional — force verbose GTM SDK console logs in production
# NEXT_PUBLIC_GTM_DEBUG=true

# -----------------------------------------------------------------------------
# Facebook Conversions API (Server-side)
# -----------------------------------------------------------------------------
# Format: pixelId1:accessToken1,pixelId2:accessToken2
FACEBOOK_MULTI_CAPI_ACCESS_TOKENS=your-pixel-id:your-capi-access-token
# Optional: override Graph API URL
# FACEBOOK_CAPI_BASE_URL=https://graph.facebook.com/v21.0
# HMAC secret for CAPI endpoint security (generate with: openssl rand -hex 32)
NEXT_PUBLIC_CAPI_HMAC_SECRET=your-capi-hmac-secret

# -----------------------------------------------------------------------------
# SEO Configuration (required by @shopkit/seo)
# -----------------------------------------------------------------------------
# Your site's root URL — no trailing slash. Used for canonical URLs, OG tags,
# and structured data. Required; build will fail if unset.
NEXT_PUBLIC_BASE_URL=https://yourstore.com
# Your brand/store name. Used in <title> tags and structured data.
NEXT_PUBLIC_SITE_NAME=Your Store Name
# Optional SEO fields
# NEXT_PUBLIC_SITE_DESCRIPTION=Your store description
# NEXT_PUBLIC_DEFAULT_IMAGE=https://yourstore.com/og-image.jpg

# Extra image CDN hostnames to allow through next/image, comma-separated.
# Each host is added to images.remotePatterns as https://<host>/** so a
# merchant can whitelist their own image host without editing next.config.js.
# NEXT_PUBLIC_IMAGE_HOSTS=cdn.yourstore.com,images.yourstore.com

# -----------------------------------------------------------------------------
# Store Contact Details (shown on the Contact page — /pages/contact)
# -----------------------------------------------------------------------------
# All optional and merchant-agnostic. When set, these override the locale
# placeholders on the Contact page, so switching merchant needs no content edits.
# Any left unset fall back to the placeholder text in the theme locale.
# NEXT_PUBLIC_STORE_EMAIL=support@yourstore.com
# NEXT_PUBLIC_STORE_PHONE=+1 (000) 000-0000
# NEXT_PUBLIC_STORE_ADDRESS=123 Commerce Street, Suite 100, Your City
# NEXT_PUBLIC_STORE_HOURS=Mon–Fri, 9:00 AM – 6:00 PM

# -----------------------------------------------------------------------------
# Theme Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_THEME_NAME=ratio

# -----------------------------------------------------------------------------
# Redis (Optional - for caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:4344
NODE_ENV=development

# -----------------------------------------------------------------------------
# Voice Agent (Ratio Voice AI) — OpenAI Realtime over WebRTC. See VOICE.md for the
# full reference. ONLY OPENAI_API_KEY is required to run; everything else has a safe
# default in code.
#
# The vars below are what a store actually configures (these become the Admin Panel
# settings later). Every other knob — VAD/barge-in tuning, turn timing, session &
# cart limits, colours, sizes, reconnect/timeout — has a safe default in code
# (voiceConfig.ts / openaiServer.ts); override those via env ONLY if you know why.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                            # REQUIRED — server-side secret, never sent to the browser

# --- Store settings (what each merchant configures) ---
# NEXT_PUBLIC_VOICE_STORE_NAME=            # how the agent SAYS the store name (voice only, NOT checkout);
#                                            falls back to NEXT_PUBLIC_MERCHANT_NAME
# NEXT_PUBLIC_VOICE_STORE_SPECIALTY=       # what the store is known for, used in the greeting (e.g. haircare)
# NEXT_PUBLIC_VOICE_LANGUAGE=Hindi or Hinglish  # DEFAULT spoken language (already the platform default; all-India). Override only for a non-Hindi-first store (e.g. "English", "Tamil"). Still switches per shopper.
# NEXT_PUBLIC_VOICE_CURRENCY=INR           # price currency — set all three for a non-INR store so it never says "rupees"
# NEXT_PUBLIC_VOICE_CURRENCY_SYMBOL=₹
# NEXT_PUBLIC_VOICE_CURRENCY_NAME=rupees   # spoken currency word (e.g. "dollars", "euros", "pounds")
# NEXT_PUBLIC_VOICE_CATALOG_LANGUAGE=English  # language your search/catalog backend indexes in (tool-query language)
# NEXT_PUBLIC_VOICE_SEARCH_PATH=/search    # your storefront's search-results path (Shopify default /search)
# NEXT_PUBLIC_GOKWIK_VALID_OFFERS_URL=     # published-coupons endpoint (enables the coupon-list voice tool)

# --- Advanced ops / security (optional; rarely touched) ---
# NEXT_PUBLIC_VOICE_ENABLED=false          # kill switch — hides the widget (default: enabled)
# OPENAI_REALTIME_VOICE=marin              # output voice (marin | cedar recommended)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1   # pin a model snapshot
# NEXT_PUBLIC_VOICE_ICE_SERVERS=           # JSON RTCIceServer[] — only for UDP-blocked (corporate/hotel) networks
# VOICE_ALLOWED_ORIGINS=                   # extra allowed origins for the token-API guard
# VOICE_PERSONA_LLM=false                  # deterministic persona (skip the LLM persona-generation call)
