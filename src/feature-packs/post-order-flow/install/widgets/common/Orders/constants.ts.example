/**
 * Canonical order-status values used across Orders, OrderDetails,
 * CancelOrderModal, ReasonSelectionStep, and OrderSummary widgets.
 * Source: backend `order.status` field.
 */
export const ORDER_STATUS = {
  PENDING: "pending",
  CONFIRMED: "confirmed",
  PROCESSING: "processing",
  SHIPPED: "shipped",
  OUT_FOR_DELIVERY: "out_for_delivery",
  DELIVERED: "delivered",
  CANCELLED: "cancelled",
  RETURNED: "returned",
  FAILED: "failed",
} as const;

export type OrderStatus = (typeof ORDER_STATUS)[keyof typeof ORDER_STATUS];

/**
 * Cancel-modal step constants used by CancelOrderModal and its child steps.
 */
export const CANCEL_MODAL_STEP = {
  CONFIRMATION: "confirmation",
  REASON_SELECTION: "reason-selection",
} as const;

export type CancelModalStep =
  (typeof CANCEL_MODAL_STEP)[keyof typeof CANCEL_MODAL_STEP];
