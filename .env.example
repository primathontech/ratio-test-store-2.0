# =============================================================================
# Environment Variables Example
# =============================================================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Commerce Platform Configuration
# -----------------------------------------------------------------------------
# Choose your commerce platform: "shopify" or "custom"
NEXT_PUBLIC_COMMERCE_PLATFORM=custom

# -----------------------------------------------------------------------------
# Shopify Configuration (if using Shopify)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# -----------------------------------------------------------------------------
# Custom Backend Configuration (if using custom)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CUSTOM_API_URL=https://your-api.com
NEXT_PUBLIC_MERCHANT_ID=your-merchant-id

# -----------------------------------------------------------------------------
# Navigation / Mega Menu (@shopkit/navigation)
# -----------------------------------------------------------------------------
# Full gateway base INCLUDING the /api/v1 prefix; the package appends
# /storefront/nav-menus/{handle}. If unset, the header/footer degrade gracefully
# (fallback nav, no crash). The menu CONTENT is managed by the merchant in admin.
#   QA:   https://api-gw-v4.dev.gokwik.io/qa/pi/pc/api/v1
#   Prod: https://api-gateway.gokwik.io/api/v1
NEXT_PUBLIC_NAV_MENU_API_URL=

# -----------------------------------------------------------------------------
# GoKwik Checkout Integration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOKWIK_MID=your-gokwik-merchant-id
NEXT_PUBLIC_GOKWIK_ENVIRONMENT=sandbox
NEXT_PUBLIC_GOKWIK_TYPE=your-gokwik-type
NEXT_PUBLIC_GOKWIK_SCRIPT_URL=https://cdn.gokwik.co

# Optional: Banner messages shown in checkout
NEXT_PUBLIC_GOKWIK_BANNER_MESSAGE_1=Free shipping on orders above ₹499
NEXT_PUBLIC_GOKWIK_BANNER_MESSAGE_2=Easy returns within 7 days

# -----------------------------------------------------------------------------
# GoKwik KwikPass (Authentication)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKPASS_MID=your-kwikpass-merchant-id
NEXT_PUBLIC_KWIKPASS_ENVIRONMENT=sandbox
NEXT_PUBLIC_KWIKPASS_SCRIPT_URL=https://cdn.gokwik.co

# -----------------------------------------------------------------------------
# GoKwik KwikCart (Side Cart)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKCART_DISABLE=false
NEXT_PUBLIC_KWIKCART_SCRIPT_URL=https://qa.kwikcart.gokwik.co/kwikcart/side-cart.js
NEXT_PUBLIC_KWIKCART_CURRENCY=INR
NEXT_PUBLIC_KWIKCART_CURRENCY_FORMAT=en-IN

# -----------------------------------------------------------------------------
# Order History API (for /orders page)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL=https://your-api.com

# -----------------------------------------------------------------------------
# Analytics & Tracking (Optional)
# -----------------------------------------------------------------------------
# Comma-separated Facebook Pixel IDs (supports multiple pixels)
NEXT_PUBLIC_MULTI_PIXEL_IDS=your-pixel-id-1,your-pixel-id-2
NEXT_PUBLIC_GOOGLE_ADS_ID=your-google-ads-id
NEXT_PUBLIC_GOOGLE_CONVERSION_LABEL=your-conversion-label

# Google Tag Manager — merchant-controlled container.
# When set, gtm-pixel-sdk.js loads the container, applies Consent Mode v2
# defaults, and mirrors PixelRuntime events into window.dataLayer using GA4
# Enhanced Ecommerce schema. Leave blank to disable.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Optional — only needed for GTM Server-Side environments (preview/staging)
# NEXT_PUBLIC_GTM_AUTH=your-gtm-server-side-auth-token
# NEXT_PUBLIC_GTM_PREVIEW=env-X
# Optional — ISO 4217 currency for ecommerce events (default "INR")
# NEXT_PUBLIC_CURRENCY=USD
# Optional — force verbose GTM SDK console logs in production
# NEXT_PUBLIC_GTM_DEBUG=true

# -----------------------------------------------------------------------------
# Facebook Conversions API (Server-side)
# -----------------------------------------------------------------------------
# Format: pixelId1:accessToken1,pixelId2:accessToken2
FACEBOOK_MULTI_CAPI_ACCESS_TOKENS=your-pixel-id:your-capi-access-token
# Optional: override Graph API URL
# FACEBOOK_CAPI_BASE_URL=https://graph.facebook.com/v21.0
# HMAC secret for CAPI endpoint security (generate with: openssl rand -hex 32)
NEXT_PUBLIC_CAPI_HMAC_SECRET=your-capi-hmac-secret

# -----------------------------------------------------------------------------
# SEO Configuration (required by @shopkit/seo)
# -----------------------------------------------------------------------------
# Your site's root URL — no trailing slash. Used for canonical URLs, OG tags,
# and structured data. Required; build will fail if unset.
NEXT_PUBLIC_BASE_URL=https://yourstore.com
# Your brand/store name. Used in <title> tags and structured data.
NEXT_PUBLIC_SITE_NAME=Your Store Name
# Optional SEO fields
# NEXT_PUBLIC_SITE_DESCRIPTION=Your store description
# NEXT_PUBLIC_DEFAULT_IMAGE=https://yourstore.com/og-image.jpg

# -----------------------------------------------------------------------------
# Theme Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_THEME_NAME=dawn

# -----------------------------------------------------------------------------
# Redis (Optional - for caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:4344
NODE_ENV=development

# -----------------------------------------------------------------------------
# Voice Agent (Ratio Voice AI)
# Single provider: OpenAI Realtime over WebRTC. See VOICE.md for full reference.
# Most knobs below have safe code defaults (voiceConfig.ts) — only OPENAI_API_KEY
# and NEXT_PUBLIC_VOICE_PROVIDER are needed to run.
# -----------------------------------------------------------------------------
# --- Server (secret / runtime) ---
OPENAI_API_KEY=                          # REQUIRED to run live; never exposed to the browser
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1 # realtime model (default shown)
# OPENAI_PERSONA_MODEL=                  # model used to auto-generate the store persona
# OPENAI_VAD_THRESHOLD=                  # barge-in tuning
# OPENAI_VAD_PREFIX_MS=
# OPENAI_VAD_SILENCE_MS=
# VOICE_PROVIDER=openai                  # server override; falls back to NEXT_PUBLIC_VOICE_PROVIDER
# VOICE_PERSONA_LLM=                     # "false" = deterministic persona (no LLM)
# VOICE_PERSONA_BUDGET_MS=
# VOICE_CATALOG_LANGUAGE=
# VOICE_ALLOWED_ORIGINS=                 # extra allowed origins for the API guard (same-origin always allowed)
# --- Client (NEXT_PUBLIC_*, build-time) ---
NEXT_PUBLIC_VOICE_ENABLED=true           # "false" disables the widget (kill switch)
NEXT_PUBLIC_VOICE_PROVIDER=openai
# Proactive opening greeting (agent speaks first on a fresh session). ON by default.
# NEXT_PUBLIC_VOICE_GREETING_ENABLED=false   # restore silent-until-shopper-speaks
# NEXT_PUBLIC_VOICE_GREETING=...             # override the one-shot greeting directive
#   (still rendered in the store persona; keep it a single sentence)
# NEXT_PUBLIC_VOICE_CATALOG_LANGUAGE=English
# Currency the agent quotes prices in (default INR/₹). Set BOTH for a non-INR store
# so the agent never defaults to USD:
# NEXT_PUBLIC_VOICE_CURRENCY=INR          # ISO code (e.g. USD, EUR, GBP)
# NEXT_PUBLIC_VOICE_CURRENCY_SYMBOL=₹     # display symbol (e.g. $, €, £)
# Which nav menu(s) the agent resolves browsable collections from (so it opens the
# SAME collections the storefront menu shows, never a hidden/-copy catalog entry).
# By DEFAULT this is auto-derived from the chrome the storefront renders
# (renderChrome().menuHandles — header + footer, editor-aware), so it follows an
# editor menu change automatically. Set this ONLY to override that (comma-separated):
# NEXT_PUBLIC_VOICE_COLLECTION_MENUS=main-menu   # e.g. "main-menu,categories"
# NEXT_PUBLIC_GOKWIK_VALID_OFFERS_URL=   # store's published-coupons endpoint (enables coupon-list tool)
# Limits / timing / appearance (all optional; code defaults apply):
# NEXT_PUBLIC_VOICE_MAX_SESSION_MS= NEXT_PUBLIC_VOICE_MAX_TURNS= NEXT_PUBLIC_VOICE_MAX_QTY=
# NEXT_PUBLIC_VOICE_WORKING_SET= NEXT_PUBLIC_VOICE_TOKEN_FRESH_MS= NEXT_PUBLIC_VOICE_MAX_RECONNECTS=
# NEXT_PUBLIC_VOICE_RECONNECT_BASE_MS= NEXT_PUBLIC_VOICE_TOOL_TIMEOUT_MS= NEXT_PUBLIC_VOICE_POSITION=
# NEXT_PUBLIC_VOICE_SIZE= NEXT_PUBLIC_VOICE_IDLE_COLOR= NEXT_PUBLIC_VOICE_LIVE_COLOR= NEXT_PUBLIC_VOICE_ICE_SERVERS=
