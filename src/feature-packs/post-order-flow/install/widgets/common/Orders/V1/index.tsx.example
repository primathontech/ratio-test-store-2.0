"use client";

import { useAuth } from "@shopkit/core/context";
import { usePathname, useRouter, useSearchParams } from "next/navigation";
import React, { useEffect, useState } from "react";
import { LeftSideBar } from "../../Account/common/LeftSideBar";
import { getDefaultNavigationItems } from "../../Account/common/constant";
import { useAddressCount } from "../../Account/hooks/useAddressCount";
import { getOrdersList, OrderListResponse } from "../api";
import { OrderHistory } from "../components/OrderHistory";
import { ThankYouView } from "../components/ThankYou";
import { OrdersProps } from "../types";
import { resolvePhoneNumber } from "../utils/phoneResolver";

export const OrdersV1: React.FC<OrdersProps> = ({ settings = {} }) => {
  const pathname = usePathname();
  const router = useRouter();
  const searchParams = useSearchParams();
  const { accessToken, logout: authLogout } = useAuth();
  const [ordersData, setOrdersData] = useState<OrderListResponse | null>(null);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string>("");
  const addressCount = useAddressCount();

  const orderId = searchParams.get("orderId");

  const currentPage = Math.max(
    1,
    parseInt(searchParams.get("page") ?? "1", 10) || 1
  );

  const gkToken =
    typeof accessToken === "string"
      ? accessToken
      : ((accessToken as { accessToken?: string; token?: string } | null)
          ?.accessToken ??
        (accessToken as { token?: string } | null)?.token ??
        "");

  const fetchOrdersData = async () => {
    try {
      setLoading(true);
      setError("");

      const phone = await resolvePhoneNumber(gkToken);

      if (!phone) {
        setError("Unable to retrieve phone number for fetching orders");
        return;
      }

      const result = await getOrdersList({
        phone,
        page: currentPage,
        limit: 10,
        requestId: Date.now().toString(),
        gkAccessToken: gkToken,
      });

      if (result) {
        setOrdersData(result);
      } else {
        setError("Failed to fetch orders data");
      }
    } catch {
      setError("An error occurred while fetching orders");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (!orderId && accessToken) {
      fetchOrdersData();
    } else if (!accessToken) {
      setLoading(false);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [currentPage, accessToken, orderId]);

  // If orderId is present in URL params, render the Thank You view
  if (orderId) {
    return <ThankYouView />;
  }

  const handleLogout = () => {
    localStorage.removeItem("customerDetails");
    authLogout();
    if (typeof window !== "undefined" && (window as any).handleLogout) {
      (window as any).handleLogout("/");
    }
    window.location.replace("/");
  };

  const handlePageChange = (page: number) => {
    const params = new URLSearchParams(searchParams.toString());

    if (page <= 1) {
      params.delete("page");
    } else {
      params.set("page", page.toString());
    }

    const newUrl = `${pathname}${params.size ? `?${params}` : ""}`;
    router.push(newUrl, { scroll: false });
  };

  const isOrdersPage = pathname === "/pages/orders";
  const isAddressesPage = pathname === "/account/addresses";
  const isDashboardPage = pathname === "/account";

  const navigationItems =
    settings.navigationItems ||
    getDefaultNavigationItems(
      isDashboardPage,
      isOrdersPage,
      isAddressesPage,
      addressCount
    );

  if (loading) {
    return (
      <div className="bg-white">
        <div className="mx-auto">
          <div className="grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-[30px] px-[15px] md:px-[30px] xl:px-[70px]">
            <LeftSideBar
              navigationItems={navigationItems}
              onLogout={handleLogout}
              isNavSticky
            />
            <main
              key={pathname}
              className="flex-1"
              data-testid="storefront-account-main-content"
            >
              <div className="flex items-center justify-center min-h-[400px]">
                <div className="text-center">
                  <div className="animate-spin rounded-full h-12 w-12 border-4 border-black border-t-transparent mx-auto mb-4"></div>
                  <p className="text-gray-600">Loading orders...</p>
                </div>
              </div>
            </main>
          </div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="bg-white">
        <div className="mx-auto">
          <div className="grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-[30px] px-[15px] md:px-[30px] xl:px-[70px]">
            <LeftSideBar
              navigationItems={navigationItems}
              onLogout={handleLogout}
              isNavSticky
            />
            <main
              key={pathname}
              className="flex-1"
              data-testid="storefront-account-main-content"
            >
              <div className="flex items-center justify-center min-h-[400px]">
                <div className="text-center">
                  <p className="text-red-600 mb-4">{error}</p>
                  <button
                    onClick={() => window.location.reload()}
                    className="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"
                  >
                    Retry
                  </button>
                </div>
              </div>
            </main>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="bg-white min-h-[600px] md:min-h-[341px]">
      <div className="mx-auto">
        <div className="grid grid-cols-1 md:grid-cols-[1fr_3fr] gap-[16px] px-[15px] md:px-[30px] xl:px-[70px]">
          <LeftSideBar
            navigationItems={navigationItems}
            onLogout={handleLogout}
            isNavSticky
          />

          <main
            key={pathname}
            className="flex-1"
            data-testid="storefront-account-main-content"
          >
            <OrderHistory
              orders={ordersData?.orders}
              totalPages={ordersData?.pagination?.totalPages ?? 1}
              currentPage={currentPage}
              onPageChange={handlePageChange}
              onOrderUpdate={fetchOrdersData}
            />
          </main>
        </div>
      </div>
    </div>
  );
};

export default OrdersV1;
