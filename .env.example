# =============================================================================
# Ratio storefront — environment
# =============================================================================
# Merchant-specific config. Switching merchant = change the values here only
# (no code/UI edits). Keep this file out of version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Commerce platform & merchant identity
# -----------------------------------------------------------------------------
# Backend type: "custom" (GoKwik) or "shopify". Both server + public copies.
PLATFORM=custom
NEXT_PUBLIC_PLATFORM=custom

# Merchant / store identifiers — all point at the same GoKwik merchant.
MERCHANT_ID=196jdfqy1aot
NEXT_PUBLIC_MERCHANT_ID=196jdfqy1aot
NEXT_PUBLIC_STORE_ID=196jdfqy1aot

# Theme folder + internal merchant name (src/themes/<name>).
MERCHANT_NAME=ratio
NEXT_PUBLIC_MERCHANT_NAME=ratio
NEXT_PUBLIC_THEME_NAME=ratio

# -----------------------------------------------------------------------------
# Site / SEO
# -----------------------------------------------------------------------------
# Root URL (no trailing slash) — canonical URLs, OG tags, sitemap, structured data.
NEXT_PUBLIC_BASE_URL=https://ratioproduction.ratio.win
# Brand/store name — <title> tags, structured data, footer copyright.
NEXT_PUBLIC_SITE_NAME=Ratio

# -----------------------------------------------------------------------------
# Commerce data APIs (custom / GoKwik backend)
# -----------------------------------------------------------------------------
# Catalog (products/collections), cart, customer, orders, search endpoints.
NEXT_PUBLIC_CUSTOM_API_PRODUCT_URL=https://gkx.gokwik.co/ps
NEXT_PUBLIC_CUSTOM_API_CART_URL=https://gkx.gokwik.co/os
NEXT_PUBLIC_CUSTOM_API_ORDER_HISTORY_URL=https://gkx.gokwik.co/os/api/v1
NEXT_PUBLIC_CUSTOMER_API_URL=https://gkx.gokwik.co/cs/v1
NEXT_PUBLIC_SEARCH_API_URL=https://api-gw.gokwik.io/search/api/v1
# Navigation / Mega Menu (@shopkit/navigation)
# -----------------------------------------------------------------------------
# Generic storefront-config gateway base — ONE URL for ALL admin config reads:
# navigation (@shopkit/navigation → /storefront/nav-menus/{handle}), SEO
# (@shopkit/seo → /storefront/configs/seo/default), and future config domains.
# Full gateway base INCLUDING the /api/v1 prefix; each package appends its own tail.
# If unset, both degrade gracefully (fallback nav / env-default SEO — no crash).
# CONTENT (menus, SEO title/description) is managed by the merchant in admin.
#   QA:   https://api-gw-v4.dev.gokwik.io/qa/pi/pc/api/v1
#   Prod: https://api-gw-v4.gokwik.io/pi/pc/api/v1   (the public API gateway — never a service host)
NEXT_PUBLIC_STOREFRONT_API_URL=

# DEPRECATED — legacy nav-only var. @shopkit/navigation still reads it as a fallback
# when NEXT_PUBLIC_STOREFRONT_API_URL is unset. Prefer the generic var above; this
# will be removed. Leave blank unless supporting an older deploy.
# NEXT_PUBLIC_NAV_MENU_API_URL=

# -----------------------------------------------------------------------------
# Visual Editor Integration
# -----------------------------------------------------------------------------
# THE switch for editor-saved templates. This is the only thing that decides
# whether templates come from the editor backend or from src/themes/ on disk —
# it selects the template loader once, in src/bootstrap/builder.ts. Compared
# strictly against the string "true"; anything else (including unset) means
# filesystem-only. Do NOT try to control this per-page: `fetchAPITemplate` in a
# page's routeContext is not read on the render path.
#   false / unset → templates load from src/themes/{theme}/templates/
#   true          → templates load from NEXT_PUBLIC_EDITOR_API_URL, falling back
#                   to the filesystem if the backend call fails
NEXT_PUBLIC_ENABLE_EDITOR_CHANGES=false

# Editor backend base URL. Only used when the flag above is "true".
# Defaults to https://api-gw-v4.dev.gokwik.in/uat/os-editor when unset.
NEXT_PUBLIC_EDITOR_API_URL=

# -----------------------------------------------------------------------------
# Storefront config & navigation (admin-managed via @shopkit/*)
# -----------------------------------------------------------------------------
# Gateway base for admin config: nav menus (useNav) + SEO config.
NEXT_PUBLIC_STOREFRONT_API_URL=https://api-gw-v4.gokwik.io/pi/pc/api/v1
# Legacy nav-only fallback (kept for compatibility).
NEXT_PUBLIC_NAV_MENU_API_URL=https://api-gw-v4.gokwik.io/pi/pc/api/v1

# -----------------------------------------------------------------------------
# GoKwik checkout
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOKWIK_ENABLED=true
NEXT_PUBLIC_GOKWIK_ENVIRONMENT=production
NEXT_PUBLIC_GOKWIK_MID=196jdfqy1aot
NEXT_PUBLIC_GOKWIK_TYPE=merchantInfo
NEXT_PUBLIC_GOKWIK_SCRIPT_URL=https://pdp.gokwik.co
NEXT_PUBLIC_GOKWIK_DISCOUNT_API_URL=https://gkx.gokwik.co/pi/od/api/v1/os-discount/fetch

# -----------------------------------------------------------------------------
# KwikCart (GoKwik side cart)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_KWIKCART_DISABLE=false
NEXT_PUBLIC_KWIKCART_SCRIPT_URL=https://kwikcart.gokwik.co/kwikcart/side-cart-os.js
NEXT_PUBLIC_KWIKCART_CURRENCY=INR
NEXT_PUBLIC_KWIKCART_CURRENCY_FORMAT=en-IN

# -----------------------------------------------------------------------------
# Visual editor
# -----------------------------------------------------------------------------
# Enable editor-driven config changes at runtime.
NEXT_PUBLIC_ENABLE_EDITOR_CHANGES=false

# -----------------------------------------------------------------------------
# Voice AI (Ratio Voice AI assistant)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VOICE_STORE_NAME=ratio
NEXT_PUBLIC_VOICE_STORE_SPECIALTY=haircare
# OpenAI key powering the voice assistant (SECRET).
OPENAI_API_KEY=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

# -----------------------------------------------------------------------------
# Ratio Forms
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RATIO_FORMS_SDK_URL=https://ratio.apps.primathontech.co.in/forms/sdk/196jdfqy1aot.js

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------
# Signing secret for verifying inbound webhooks (SECRET).
WEBHOOK_SECRET=whsec_LKhNJjCzZrE54JRdGfD_rMe8381nqF8cKAhZvg3TwB0
NEXT_PUBLIC_APP_URL=http://localhost:4344
NODE_ENV=development

# -----------------------------------------------------------------------------
# Observability (@shopkit/observability → SigNoz)
# -----------------------------------------------------------------------------
# Collector OTLP/HTTP traces endpoint. Set = browser and server monitoring on
# (/api/obs and server traces send to it); unset = off. Release (next build ID)
# and environment (NEXT_PUBLIC_GOKWIK_ENVIRONMENT) are picked up automatically.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Collector auth headers, if it needs any (e.g. signoz-ingestion-key=<key>).
# Prod value in the secrets vault only.
OTEL_EXPORTER_OTLP_HEADERS=

# -----------------------------------------------------------------------------
# Apps Platform
# -----------------------------------------------------------------------------
# Master switch. Off/unset → the app widgets are not registered at all, so a
# template carrying an AppBlockZone renders nothing (and logs nothing).
NEXT_PUBLIC_APPS_PLATFORM_ENABLED=false

# App Ecosystem store. BOTH are server-only credentials — never prefix them with
# NEXT_PUBLIC_, or the storefront token ships to every visitor. The browser
# reaches the store only through /api/v1/apps/installed.
RATIO_APPS_API_URL=
RATIO_APPS_STOREFRONT_TOKEN=
# The merchant this storefront serves, as the store knows it. Same value as
# NEXT_PUBLIC_MERCHANT_ID above — kept separate because this one is read only
# on the server, beside the token. Leave it unset and the route falls back to
# the public one rather than sending an empty header.
MERCHANT_ID=your-merchant-id

# Sandbox shell document. Defaults to /apps-platform/sandbox.html (copied from
# @shopkit/apps-platform at build time); set this only to host it elsewhere.
# RATIO_APPS_SHELL_URL=

# Build-time prerender switch. "true" makes product/collection generateStaticParams
# return [] so `next build` makes no catalog calls and pages render on first request.
# Use when the build host is rate-limited by the API gateway (a 429 now fails the
# page render, so prerendering hundreds of pages would fail the build). Default: off.
# SKIP_BUILD_STATIC_PARAMS=true
